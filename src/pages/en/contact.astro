---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import FadeIn from '../../components/FadeIn.astro';
---

<BaseLayout
  locale="en"
  title="Contact | Kamiyama School Intro"
  description="Sample contact form UI for external form services."
>
  <Section title="Contact" subtitle="The submit endpoint should be connected to an external form service.">
    <FadeIn>
      <form
        class="space-y-5 rounded-[var(--radius-card)] border border-ink/10 bg-white/90 p-8 shadow-card"
        action="https://example.com/TODO"
        method="post"
      >
        <div>
          <label for="name" class="block text-sm">Name</label>
          <input
            id="name"
            name="name"
            required
            class="mt-2 w-full rounded-xl border border-ink/20 bg-white px-4 py-3"
            type="text"
          />
        </div>
        <div>
          <label for="email" class="block text-sm">Email</label>
          <input
            id="email"
            name="email"
            required
            class="mt-2 w-full rounded-xl border border-ink/20 bg-white px-4 py-3"
            type="email"
          />
        </div>
        <div>
          <label for="message" class="block text-sm">Message</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            class="mt-2 w-full rounded-xl border border-ink/20 bg-white px-4 py-3"
          ></textarea>
        </div>
        <button
          class="rounded-full bg-green px-6 py-3 text-sm font-semibold tracking-wide text-white hover:bg-[#5e7d50]"
          type="submit"
        >
          Submit (endpoint TODO)
        </button>
      </form>
    </FadeIn>
  </Section>
</BaseLayout>