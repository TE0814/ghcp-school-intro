---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import FadeIn from '../../components/FadeIn.astro';
---

<BaseLayout
  locale="en"
  title="About | Kamiyama School Intro"
  description="Sample overview of mission, vision, and school timeline."
>
  <Section title="Mission" subtitle="We educate people who can prototype better futures.">
    <FadeIn>
      <div class="space-y-4 rounded-[var(--radius-card)] border border-ink/10 bg-white/80 p-8 shadow-card">
        <p>
          The school aims to deliver implementation-oriented education where students integrate
          technology, design, and entrepreneurship.
        </p>
        <p>
          Learners engage with real contexts through collaborations with local communities, public
          organizations, and companies.
        </p>
      </div>
    </FadeIn>
  </Section>

  <Section title="Vision" className="pt-0">
    <div class="grid gap-6 md:grid-cols-3">
      <FadeIn>
        <div class="rounded-[var(--radius-card)] bg-beige/65 p-6">Self-driven problem finders and builders</div>
      </FadeIn>
      <FadeIn>
        <div class="rounded-[var(--radius-card)] bg-green/15 p-6">Cross-disciplinary teamwork in action</div>
      </FadeIn>
      <FadeIn>
        <div class="rounded-[var(--radius-card)] bg-wood/25 p-6">Outputs connecting local and global communities</div>
      </FadeIn>
    </div>
  </Section>

  <Section title="Timeline (Sample)" className="pt-0">
    <FadeIn>
      <ol class="space-y-4 rounded-[var(--radius-card)] border border-ink/10 bg-white/75 p-8">
        <li>2023: School concept announced</li>
        <li>2024: Pilot partnerships with regional projects</li>
        <li>2025: Campus and curriculum design accelerated</li>
        <li>2026: Initial program implementation underway</li>
      </ol>
    </FadeIn>
  </Section>
</BaseLayout>